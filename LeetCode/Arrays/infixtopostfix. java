class Solution {
        static int precedence (char x)
        {
            if(x == '+' || x == '-')
            {
                return 1;
            }
            else if(x == '*' || x == '/')
            {
                return 2;
            }
            else if(x == '^')
            {
                return 3;
            }
            else
            {
                return 0;
            }
        }
public static String infixToPostfix(String s) {
        // code here
        StringBuilder result =new StringBuilder();
       Stack<Character> stack=new Stack<>();
        for(char ch : s.toCharArray())
        {
            if(Character.isLetterOrDigit(ch))
            {
                result. append(ch);
            }
            else if(ch=='(')
            {
                stack.push(ch);
            }
            else if(ch==')')
            {
                while(!stack.empty() && stack.peek()!='(')
                {
                result. append(stack.pop());
                }
                stack.pop();
                }
             else  {
                 
             while(!stack.empty() && stack.peek()!='(' && (precedence(ch)<precedence(stack.peek()) || (precedence(ch)==precedence(stack.peek())&& ch!='^')))
             {
                 result. append(stack.pop());
             }
             stack.push(ch);
             }
        }
             while (!stack.isEmpty ())
             {
                 result. append(stack.pop());
             }
            
        return result. toString();
}

}