class Solution {
    public int largestUniqueNumber(int[] nums) {
        // Your code goes here
        HashMap <Integer,Integer> map=new HashMap<>();
        for (int i:nums)
            {
               map.put(i,map.getOrDefault (i,0)+1);
            }
        int max=-1;
        for(int num:nums)
            {
                if(map.get(num)==1)
                {
                    max=Math.max(max,num);
                }
            }
        return max;
    }
}