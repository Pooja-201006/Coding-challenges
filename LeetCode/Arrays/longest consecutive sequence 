class Solution {
    public int longestConsecutive(int[] nums) {
        Arrays.sort(nums);
        int longest=1;
        int count =1;
        int n=nums.length;
        if(n==0)
        {
            return 0;
        }
        for(int i=1;i<n;i++)
            {
                if(nums[i]==nums[i-1])
                {
                    continue;
                }
                else if(nums[i]==nums[i-1]+1)
                {
                    count++;
                }
                else
                {
                count =1;
                }
                longest =Math.max(longest,count);
            }
      return longest;
    }
}