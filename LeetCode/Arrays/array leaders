class Solution {
    static ArrayList<Integer> leaders(int arr[]) {
        // code here
        ArrayList<Integer> leaders=new ArrayList<>();

       int n=arr.length;
       int max=arr[n-1];
       leaders.add(max);
       for(int i=n-2;i>=0;i--)
        {
            if(arr[i]>=max)
            {
                leaders.add(arr[i]);
                max=arr[i];
                
            }
        }
        Collections.reverse(leaders);
        return leaders;
    }
}
