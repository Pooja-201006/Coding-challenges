class Solution {
    public boolean isPalindrome(int x) {
        boolean palindrome =false;
        int rev=0;
        int num=x;
        while(num>0)
            {
                rev=rev*10+num%10;
                num/=10;
            }
        if(rev==x)
        {
            return true;
        }
        return false;
    }
}